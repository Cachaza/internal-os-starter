DATABASE_URL=postgresql://postgres:password@localhost:5432/internal_os

# LISTEN/NOTIFY normally wakes the worker immediately. Reconciliation bounds
# recovery after a lost notification or listener reconnect to 30 seconds.
JOB_RECONCILE_INTERVAL_MS=30000
# A stopped worker's job becomes claimable after one minute. Healthy workers
# renew this lease every one third of the configured duration.
JOB_LEASE_MS=60000
# Three attempts expose repeatable failures without retrying indefinitely.
JOB_MAX_ATTEMPTS=3
