BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/internal_os

# Safety-net reconciliation recovers from lost notifications or listener reconnects;
# scheduled jobs still wake at their exact run_at time when it is sooner.
JOB_RECONCILE_INTERVAL_MS=30000
JOB_MAX_ATTEMPTS=3
